{
  "$meta": {
    "ds": "webconfig",
    "tier": "semantic",
    "version": "1.0",
    "$description": "Aliases con variantes light/dark. Las referencias usan sintaxis DTCG {grupo.token}."
  },
  "bg": {
    "base": {
      "$value": "{color.neutral.0}",
      "$type": "color",
      "$description": "Fondo página",
      "$extensions": { "mode": { "light": "{color.neutral.0}", "dark": "{color.neutral.950}" } }
    },
    "surface": {
      "$value": "{color.neutral.50}",
      "$type": "color",
      "$description": "Fondo tarjetas y superficies",
      "$extensions": { "mode": { "light": "{color.neutral.50}", "dark": "{color.neutral.900}" } }
    },
    "muted": {
      "$value": "{color.neutral.100}",
      "$type": "color",
      "$description": "Fondo atenuado",
      "$extensions": { "mode": { "light": "{color.neutral.100}", "dark": "{color.neutral.800}" } }
    }
  },
  "text": {
    "base": {
      "$value": "{color.neutral.900}",
      "$type": "color",
      "$description": "Texto principal",
      "$extensions": { "mode": { "light": "{color.neutral.900}", "dark": "{color.neutral.0}" } }
    },
    "muted": {
      "$value": "{color.neutral.600}",
      "$type": "color",
      "$description": "Texto secundario",
      "$extensions": { "mode": { "light": "{color.neutral.600}", "dark": "{color.neutral.300}" } }
    },
    "link": {
      "$value": "{color.brand.700}",
      "$type": "color",
      "$description": "Enlaces",
      "$extensions": { "mode": { "light": "{color.brand.700}", "dark": "{color.brand.300}" } }
    }
  },
  "border": {
    "base": {
      "$value": "{color.neutral.400}",
      "$type": "color",
      "$description": "Bordes (minimo 3:1 UI en light y dark)",
      "$extensions": { "mode": { "light": "{color.neutral.500}", "dark": "{color.neutral.500}" } }
    },
    "strong": {
      "$value": "{color.neutral.500}",
      "$type": "color",
      "$extensions": { "mode": { "light": "{color.neutral.500}", "dark": "{color.neutral.400}" } }
    }
  },
  "action": {
    "primary-bg": {
      "$value": "{color.brand.600}",
      "$type": "color",
      "$description": "Fondo botón primario"
    },
    "primary-bg-hover": {
      "$value": "{color.brand.700}",
      "$type": "color",
      "$description": "Fondo botón primario hover"
    },
    "on-primary": {
      "$value": "{color.neutral.0}",
      "$type": "color",
      "$description": "Texto sobre primario"
    },
    "secondary-bg": {
      "$value": "{color.neutral.100}",
      "$type": "color",
      "$description": "Fondo botón secundario",
      "$extensions": { "mode": { "light": "{color.neutral.100}", "dark": "{color.neutral.800}" } }
    },
    "on-secondary": {
      "$value": "{color.neutral.900}",
      "$type": "color",
      "$description": "Texto sobre secundario",
      "$extensions": { "mode": { "light": "{color.neutral.900}", "dark": "{color.neutral.0}" } }
    },
    "focus-ring": {
      "$value": "{color.focus.ring}",
      "$type": "color",
      "$description": "Anillo de foco"
    }
  },
  "feedback": {
    "success-bg": { "$value": "{color.success.600}", "$type": "color" },
    "success-text": { "$value": "{color.neutral.0}", "$type": "color" },
    "warning-bg": { "$value": "{color.warning.600}", "$type": "color" },
    "warning-text": { "$value": "{color.neutral.0}", "$type": "color" },
    "danger-bg": { "$value": "{color.danger.600}", "$type": "color" },
    "danger-text": { "$value": "{color.neutral.0}", "$type": "color" }
  }
}
