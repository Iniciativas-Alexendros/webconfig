{
  "blocks": [
    {
      "id": "header-main",
      "type": "header",
      "values": {
        "cta": {
          "href": "/contacto",
          "label": "Reservar cita",
          "target": "_self"
        },
        "logo": {
          "alt": "Clínica Dental Sur",
          "href": "/",
          "src": "assets/brand/logo.svg"
        },
        "navigation": [
          {
            "href": "/",
            "label": "Inicio"
          },
          {
            "href": "/servicios",
            "label": "Servicios"
          },
          {
            "href": "/contacto",
            "label": "Contacto"
          }
        ]
      }
    },
    {
      "id": "hero-contacto",
      "type": "hero",
      "values": {
        "background": {
          "alt": "Recepción de la clínica",
          "src": "assets/media/images/contacto-hero.jpg"
        },
        "cta": {
          "href": "tel:+34912345678",
          "label": "Llamar ahora",
          "target": "_self"
        },
        "headline": "Pide tu Cita",
        "subheadline": "Estamos aquí para ayudarte. Rellena el formulario y te contactaremos en menos de 24h."
      }
    },
    {
      "id": "contact-form",
      "type": "contact-form",
      "values": {
        "fields": [
          {
            "label": "Nombre completo",
            "name": "nombre",
            "placeholder": "Juan Pérez",
            "required": true,
            "type": "text"
          },
          {
            "label": "Email",
            "name": "email",
            "placeholder": "juan@ejemplo.com",
            "required": true,
            "type": "email"
          },
          {
            "label": "Teléfono",
            "name": "telefono",
            "placeholder": "+34 600 000 000",
            "required": true,
            "type": "tel"
          },
          {
            "label": "Servicio de interés",
            "name": "servicio",
            "options": [
              {
                "label": "Implantología",
                "value": "implantes"
              },
              {
                "label": "Ortodoncia",
                "value": "ortodoncia"
              },
              {
                "label": "Estética Dental",
                "value": "estetica"
              },
              {
                "label": "Odontología General",
                "value": "general"
              },
              {
                "label": "Urgencia",
                "value": "urgencia"
              }
            ],
            "required": false,
            "type": "select"
          },
          {
            "label": "Mensaje / Síntomas",
            "name": "mensaje",
            "placeholder": "Cuéntanos qué necesitas...",
            "required": false,
            "type": "textarea"
          }
        ],
        "submitLabel": "Enviar solicitud",
        "successMessage": "¡Gracias! Te contactaremos en menos de 24 horas para confirmar tu cita."
      }
    },
    {
      "id": "info-contacto",
      "type": "icon-list",
      "values": {
        "items": [
          {
            "icon": "map-pin",
            "text": "Calle Mayor, 45 - 28013 Madrid"
          },
          {
            "icon": "phone",
            "text": "+34 912 345 678"
          },
          {
            "icon": "mail",
            "text": "info@clinicadentalsur.es"
          },
          {
            "icon": "clock",
            "text": "L-V: 9:00-20:00 | S: 9:00-14:00"
          }
        ]
      }
    },
    {
      "id": "map-placeholder",
      "type": "image",
      "values": {
        "alt": "Mapa de ubicación de Clínica Dental Sur",
        "caption": "Nuestra clínica en el centro de Madrid",
        "src": "assets/media/images/mapa-clinica.jpg"
      }
    },
