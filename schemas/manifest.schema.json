{
  "$id": "https://webconfig.dev/schemas/manifest.schema.json",
  "title": "Manifest",
  "version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "bundleVersion",
    "createdAt",
    "description",
    "integrity",
    "name",
    "siteConfig",
    "updatedAt"
  ],
  "properties": {
    "bundleVersion": {
      "type": "string",
      "pattern": "^1\\.0\\.0$"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "files",
        "global"
      ],
      "properties": {
        "files": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "global": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "siteConfig": {
      "type": "string",
      "pattern": "^site\\.config\\.yaml$"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
