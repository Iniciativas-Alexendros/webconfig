{
  "$id": "https://webconfig.dev/schemas/seo.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SEO",
  "version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "description",
    "jsonLd",
    "keywords",
    "openGraph",
    "title",
    "twitter"
  ],
  "properties": {
    "canonical": {
      "type": [
        "string",
        "null"
      ]
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "jsonLd": {
      "type": "object",
      "additionalProperties": true
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "noIndex": {
      "type": "boolean"
    },
    "noFollow": {
      "type": "boolean"
    },
    "openGraph": {
      "type": "object",
      "additionalProperties": true
    },
    "robots": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "twitter": {
      "type": "object",
      "additionalProperties": true
    }
  }
}