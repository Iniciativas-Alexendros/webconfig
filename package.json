{
  "name": "webconfig",
  "version": "1.0.0",
  "description": "CLI validator and exporter for site.bundle v1.0.0 format",
  "type": "module",
  "private": true,
  "bin": {
    "webconfig": "./dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup src/cli.ts --format esm --dts",
    "dev": "tsup src/cli.ts --format esm --dts --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'no linter configured'"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "2.1.1",
    "commander": "11.1.0",
    "tar-stream": "3.1.6",
    "yaml": "2.9.0",
    "zod": "3.22.4"
  },
  "devDependencies": {
    "@types/node": "20.11.0",
    "tsup": "^8.5.1",
    "typescript": "5.3.3",
    "vite": "^6.4.2",
    "vite-node": "^3.0.0",
    "vitest": "^3.0.0"
  }
}
